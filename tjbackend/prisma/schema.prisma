generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("company_status")
}

enum AtsType {
  GREENHOUSE
  LEVER
  ASHBY
  WORKDAY
  SMARTRECRUITERS
  JSONLD

  @@map("ats_type")
}

enum CrawlRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  TIMED_OUT

  @@map("crawl_run_status")
}

enum JobStatus {
  ACTIVE
  CLOSED

  @@map("job_status")
}

enum WorkplaceType {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN

  @@map("workplace_type")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
  UNKNOWN

  @@map("employment_type")
}

enum Seniority {
  INTERN
  JUNIOR
  MID
  SENIOR
  STAFF
  PRINCIPAL
  MANAGER
  DIRECTOR
  UNKNOWN

  @@map("seniority")
}

enum JobCategory {
  BACKEND
  FRONTEND
  FULLSTACK
  MOBILE
  DATA_ENGINEERING
  ML_AI
  DEVOPS_SRE
  SECURITY
  QA
  EMBEDDED
  ENGINEERING_MANAGEMENT
  OTHER_ENGINEERING
  NON_ENGINEERING

  @@map("job_category")
}

enum Region {
  GLOBAL
  US
  EUROPE
  INDIA
  OTHER

  @@map("region")
}

enum SalaryPeriod {
  YEAR
  MONTH
  HOUR
  UNKNOWN

  @@map("salary_period")
}

enum JobEventType {
  FIRST_SEEN
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  LOCATION_CHANGED
  SALARY_CHANGED
  CLOSED
  REOPENED
  REPOSTED

  @@map("job_event_type")
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique // stored lowercase
  name         String
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("admin_users")
}

// The trigram GIN index company_name_trgm is created by raw SQL in the first migration.
model Company {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  slug        String        @unique
  websiteUrl  String        @map("website_url")
  logoUrl     String?       @map("logo_url")
  description String?
  hqLocation  String?       @map("hq_location")
  status      CompanyStatus @default(ACTIVE)
  notes       String? // internal only, never public
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  careerSources CareerSource[]
  jobs          Job[]

  @@index([status])
  @@map("companies")
}

model CareerSource {
  id                   String          @id @default(uuid()) @db.Uuid
  companyId            String          @map("company_id") @db.Uuid
  atsType              AtsType         @map("ats_type")
  identifier           String
  config               Json            @default("{}")
  careersPageUrl       String?         @map("careers_page_url")
  isEnabled            Boolean         @default(true) @map("is_enabled")
  crawlIntervalMinutes Int             @default(360) @map("crawl_interval_minutes")
  nextCrawlAt          DateTime        @default(now()) @map("next_crawl_at") @db.Timestamptz(3)
  lastCrawlAt          DateTime?       @map("last_crawl_at") @db.Timestamptz(3)
  lastSuccessAt        DateTime?       @map("last_success_at") @db.Timestamptz(3)
  lastRunStatus        CrawlRunStatus? @map("last_run_status")
  lastError            String?         @map("last_error")
  consecutiveFailures  Int             @default(0) @map("consecutive_failures")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  crawlRuns CrawlRun[]
  jobs      Job[]

  @@unique([atsType, identifier])
  @@index([isEnabled, nextCrawlAt])
  @@index([companyId])
  @@map("career_sources")
}

model CrawlRun {
  id                 String         @id @default(uuid()) @db.Uuid
  careerSourceId     String         @map("career_source_id") @db.Uuid
  status             CrawlRunStatus
  workerId           String         @map("worker_id")
  crawlerVersion     String?        @map("crawler_version")
  startedAt          DateTime       @default(now()) @map("started_at") @db.Timestamptz(3)
  leaseExpiresAt     DateTime       @map("lease_expires_at") @db.Timestamptz(3)
  finishedAt         DateTime?      @map("finished_at") @db.Timestamptz(3)
  isCompleteSnapshot Boolean?       @map("is_complete_snapshot")
  jobsReceived       Int            @default(0) @map("jobs_received")
  jobsCreated        Int            @default(0) @map("jobs_created")
  jobsUpdated        Int            @default(0) @map("jobs_updated")
  jobsReopened       Int            @default(0) @map("jobs_reopened")
  jobsClosed         Int            @default(0) @map("jobs_closed")
  warning            String?
  errorMessage       String?        @map("error_message")
  stats              Json?
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  careerSource CareerSource @relation(fields: [careerSourceId], references: [id], onDelete: Cascade)
  jobVersions  JobVersion[]
  jobEvents    JobEvent[]

  @@index([careerSourceId, startedAt(sort: Desc)])
  @@index([status, leaseExpiresAt])
  @@map("crawl_runs")
}

// GIN indexes (tech_tags, regions, search_vector, title trigram) and the search_vector trigger
// are created by raw SQL in the jobs migration.
model Job {
  id             String @id @default(uuid()) @db.Uuid
  slug           String @unique
  companyId      String @map("company_id") @db.Uuid
  careerSourceId String @map("career_source_id") @db.Uuid
  externalId     String @map("external_id")

  status           JobStatus @default(ACTIVE)
  isHidden         Boolean   @default(false) @map("is_hidden")
  hiddenReason     String?   @map("hidden_reason")
  duplicateOfJobId String?   @map("duplicate_of_job_id") @db.Uuid
  repostOfJobId    String?   @map("repost_of_job_id") @db.Uuid

  title           String
  normalizedTitle String  @map("normalized_title")
  descriptionHtml String  @map("description_html")
  descriptionText String  @map("description_text")
  applyUrl        String  @map("apply_url")
  sourceUrl       String? @map("source_url")
  department      String?

  locationRaw   String        @map("location_raw")
  locations     Json          @default("[]")
  countryCodes  String[]      @map("country_codes")
  regions       Region[]
  workplaceType WorkplaceType @default(UNKNOWN) @map("workplace_type")

  employmentType EmploymentType @default(UNKNOWN) @map("employment_type")
  seniority      Seniority      @default(UNKNOWN)
  category       JobCategory
  techTags       String[]       @map("tech_tags")

  salaryMin      Int?          @map("salary_min")
  salaryMax      Int?          @map("salary_max")
  salaryCurrency String?       @map("salary_currency") @db.Char(3)
  salaryPeriod   SalaryPeriod? @map("salary_period")
  salaryRaw      String?       @map("salary_raw")

  postedAt          DateTime? @map("posted_at") @db.Timestamptz(3)
  firstSeenAt       DateTime  @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(3)
  closedAt          DateTime? @map("closed_at") @db.Timestamptz(3)
  lastSeenRunId     String?   @map("last_seen_run_id") @db.Uuid // plain column, no FK
  consecutiveMisses Int       @default(0) @map("consecutive_misses")

  contentHash       String                   @map("content_hash")
  versionCount      Int                      @default(1) @map("version_count")
  normalizerVersion Int                      @map("normalizer_version")
  rawPayload        Json                     @map("raw_payload")
  searchVector      Unsupported("tsvector")? @map("search_vector")

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  careerSource CareerSource @relation(fields: [careerSourceId], references: [id], onDelete: Restrict)
  duplicateOf  Job?         @relation("Duplicates", fields: [duplicateOfJobId], references: [id], onDelete: SetNull)
  duplicates   Job[]        @relation("Duplicates")
  repostOf     Job?         @relation("Reposts", fields: [repostOfJobId], references: [id], onDelete: SetNull)
  reposts      Job[]        @relation("Reposts")
  versions     JobVersion[]
  events       JobEvent[]

  @@unique([careerSourceId, externalId])
  @@index([status, firstSeenAt(sort: Desc)])
  @@index([companyId, status])
  @@index([careerSourceId, status])
  @@index([category])
  @@index([seniority])
  @@index([duplicateOfJobId])
  @@index([repostOfJobId])
  @@map("jobs")
}

model JobVersion {
  id              String        @id @default(uuid()) @db.Uuid
  jobId           String        @map("job_id") @db.Uuid
  versionNumber   Int           @map("version_number")
  contentHash     String        @map("content_hash")
  title           String
  descriptionHtml String        @map("description_html")
  locationRaw     String        @map("location_raw")
  salaryMin       Int?          @map("salary_min")
  salaryMax       Int?          @map("salary_max")
  salaryCurrency  String?       @map("salary_currency")
  salaryPeriod    SalaryPeriod? @map("salary_period")
  salaryRaw       String?       @map("salary_raw")
  capturedAt      DateTime      @default(now()) @map("captured_at") @db.Timestamptz(3)
  crawlRunId      String?       @map("crawl_run_id") @db.Uuid

  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  crawlRun CrawlRun? @relation(fields: [crawlRunId], references: [id], onDelete: SetNull)

  @@unique([jobId, versionNumber])
  @@map("job_versions")
}

model JobEvent {
  id         String       @id @default(uuid()) @db.Uuid
  jobId      String       @map("job_id") @db.Uuid
  type       JobEventType
  occurredAt DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  crawlRunId String?      @map("crawl_run_id") @db.Uuid
  data       Json         @default("{}")

  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  crawlRun CrawlRun? @relation(fields: [crawlRunId], references: [id], onDelete: SetNull)

  @@index([jobId, occurredAt])
  @@index([type, occurredAt])
  @@map("job_events")
}
